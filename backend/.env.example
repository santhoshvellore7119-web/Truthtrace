# TruthTrace Backend Environment Variables

# Search & Fact-Checking APIs (Phase 0 & 1)
GOOGLE_FACT_CHECK_API_KEY=your_google_fact_check_api_key_here
NEWS_API_KEY=your_news_api_key_here
# GDELT 2.0 Doc API (No API key needed, rate-limited automatically)
GDELT_API_URL=https://api.gdeltproject.org/api/v2/doc/doc
# Wayback CDX API (No API key needed)
WAYBACK_CDX_API_URL=http://web.archive.org/cdx/search/cdx

# Social Media APIs (Phase 3)
REDDIT_CLIENT_ID=your_reddit_client_id
REDDIT_CLIENT_SECRET=your_reddit_client_secret
REDDIT_USER_AGENT=TruthTrace/1.0
TELEGRAM_API_ID=your_telegram_api_id
TELEGRAM_API_HASH=your_telegram_api_hash

# Video Forensics APIs (Phase 5)
YOUTUBE_API_KEY=your_youtube_api_key
GOOGLE_VISION_API_KEY=your_google_vision_api_key

# Vector Storage & Database Settings (Phase 0 & 2)
VECTOR_DB_TYPE=chroma # Options: chroma, in_memory, pgvector
CHROMA_PERSIST_DIRECTORY=./chroma_db
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/truthtrace

# LLM API Keys (for claim reasoning & synthesis)
OPENAI_API_KEY=your_openai_api_key
GOOGLE_AI_API_KEY=your_google_ai_api_key
ANTHROPIC_API_KEY=your_anthropic_api_key

# Server Settings
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
DEBUG=False